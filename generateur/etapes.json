{"catch": [{"img": "fiches-activite/etapes/catch-1.svg", "img_ar": "fiches-activite/etapes/catch-ar-1.svg", "t": "Début de partie", "c": "Je clique sur le drapeau vert : le score est mis à 0, les vies à 3 et la vitesse à 3."}, {"img": "fiches-activite/etapes/catch-2.svg", "img_ar": "fiches-activite/etapes/catch-ar-2.svg", "t": "Un poisson tombe", "c": "Un poisson apparaît en haut de la scène, à une position choisie au hasard, et il tombe."}, {"img": "fiches-activite/etapes/catch-3.svg", "img_ar": "fiches-activite/etapes/catch-ar-3.svg", "t": "Je déplace la souris", "c": "Je déplace la souris : le joueur suit la souris et se place sous le poisson."}, {"img": "fiches-activite/etapes/catch-4.svg", "img_ar": "fiches-activite/etapes/catch-ar-4.svg", "t": "Poisson attrapé", "c": "Si le joueur touche le poisson : le score augmente de 1 et un nouveau poisson apparaît."}, {"img": "fiches-activite/etapes/catch-5.svg", "img_ar": "fiches-activite/etapes/catch-ar-5.svg", "t": "Poisson manqué", "c": "Si le poisson touche le bas de la scène : les vies diminuent de 1."}, {"img": "fiches-activite/etapes/catch-6.svg", "img_ar": "fiches-activite/etapes/catch-ar-6.svg", "t": "Fin de partie", "c": "Quand les vies arrivent à 0, le jeu s'arrête : c'est la fin de la partie."}], "course": [{"img": "fiches-activite/etapes/course-1.svg", "img_ar": "fiches-activite/etapes/course-ar-1.svg", "t": "Début de partie", "c": "Je clique sur le drapeau vert : le score est mis à 0, les vies à 3 et la vitesse à 3."}, {"img": "fiches-activite/etapes/course-2.svg", "img_ar": "fiches-activite/etapes/course-ar-2.svg", "t": "Je déplace la voiture", "c": "J'appuie sur la flèche gauche ou droite : la voiture se déplace, sans sortir de la route."}, {"img": "fiches-activite/etapes/course-3.svg", "img_ar": "fiches-activite/etapes/course-ar-3.svg", "t": "Une voiture arrive", "c": "Une voiture adverse apparaît en haut, à une position choisie au hasard, et descend à la vitesse du jeu."}, {"img": "fiches-activite/etap